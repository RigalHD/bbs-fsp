{
    "schemaVersion": 1,
    "id": "bbs_fsp",
    "version": "${version}",
    "name": "BBS FSP",
    "description": "Canvas clip and graffiti form: pixel art painted over BBS FS animations",
    "authors": ["BBS FSP contributors"],
    "license": "MIT",
    "environment": "*",
    "entrypoints": {
        "client": ["mchorse.bbs_fsp.BbsFspClient"],
        "bbs-addon": ["mchorse.bbs_fsp.BbsFspAddon"],
        "bbs-client-addon": ["mchorse.bbs_fsp.BbsFspClientAddon"]
    },
    "depends": {
        "fabricloader": "${loader_dependency}",
        "minecraft": "${minecraft_dependency}",
        "java": "${java_dependency}",
        "fabric-api": "*",
        "bbs": "${bbs_dependency}"
    },
    "mixins": [
        "bbs_fsp.mixins.json",
        {
            "config": "bbs_fsp.client.mixins.json",
            "environment": "client"
        }
    ]
}
